# Build-only Dockerfile: produces the Linux native binary, not a runtime image.
# native-image does NOT cross-compile — this runs a real Linux build inside the
# container. Arch follows the container (Apple Silicon -> arm64; add
# --platform=linux/amd64 for x86_64 servers). Give Docker 8GB+ RAM.
#
# Build + extract the binary to ./out on the host (needs BuildKit):
#   docker build -f devops/Dockerfile.native --target export --output type=local,dest=./out .
#   -> ./out/solar-calc   (Linux ELF executable)
#
# For x86_64 targets from an Apple Silicon Mac:
#   docker build --platform=linux/amd64 -f devops/Dockerfile.native \
#     --target export --output type=local,dest=./out .

# ── Stage 1: Build Angular SPA ───────────────────────────────────────────────
# Node 26 is the current major; override for an LTS (e.g. --build-arg NODE_VERSION=24).
ARG NODE_VERSION=26
FROM node:${NODE_VERSION}-alpine AS webapp-build
WORKDIR /workspace/solarcalc-webapp
COPY solarcalc-webapp/package*.json ./
RUN npm ci
COPY solarcalc-webapp/ ./
RUN npm run build

# ── Stage 2: Native compile (GraalVM native-image) ───────────────────────────
# BellSoft Liberica NIK matches the Liberica JDK 25 toolchain used elsewhere.
# Tag scheme: jdk-<jdk>-nik-<nik>-<libc>. glibc is the default (dynamic linkage);
# use a *-musl tag only if you need a static binary for scratch/alpine deploys.
# The whole source tree is copied; Dockerfile.native.dockerignore drops build/, .git, etc.
FROM bellsoft/liberica-native-image-kit-container:jdk-25-nik-25-glibc AS native-build
WORKDIR /workspace
COPY . .
COPY --from=webapp-build /workspace/solarcalc-webapp/dist/solarcalc-webapp/browser \
     ./solarcalc-server/src/main/resources/static
RUN ./gradlew :solarcalc-server:nativeCompile --no-daemon

# ── Stage 3: Export just the binary to the host ──────────────────────────────
# BIN_NAME (e.g. solar-calc-linux-amd64) is the exported filename; the Gradle task sets it.
FROM scratch AS export
ARG BIN_NAME=solar-calc
COPY --from=native-build /workspace/solarcalc-server/build/native/nativeCompile/solar-calc /${BIN_NAME}
