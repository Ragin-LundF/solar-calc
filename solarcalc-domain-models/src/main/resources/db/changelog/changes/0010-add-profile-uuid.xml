<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        logicalFilePath="0010-add-profile-uuid.xml"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0010-add-profile-uuid" author="solarcalc">
        <addColumn tableName="energy_profile">
            <column name="uuid" type="VARCHAR(36)">
                <constraints nullable="true" />
            </column>
        </addColumn>

        <sql>
            UPDATE energy_profile SET uuid = UUID() WHERE uuid IS NULL
        </sql>

        <addNotNullConstraint tableName="energy_profile" columnName="uuid" columnDataType="VARCHAR(36)" />

        <addUniqueConstraint tableName="energy_profile" columnNames="uuid" constraintName="uq_energy_profile_uuid" />
    </changeSet>

</databaseChangeLog>
