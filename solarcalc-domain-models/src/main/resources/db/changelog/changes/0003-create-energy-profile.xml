<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        logicalFilePath="0003-create-energy-profile.xml"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0003-create-energy-profile" author="solarcalc">
        <createTable tableName="energy_profile">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_energy_profile_user"
                             references="solarcalc_user(id)" />
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="has_wallbox" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false" />
            </column>
            <column name="has_heat_pump" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false" />
            </column>
            <column name="heating_reference_type" type="VARCHAR(10)" defaultValue="NONE">
                <constraints nullable="false" />
            </column>
            <column name="default_electricity_price" type="DECIMAL(12,6)" />
            <column name="default_feed_in_tariff" type="DECIMAL(12,6)" />
            <column name="default_petrol_price" type="DECIMAL(12,6)" />
            <column name="default_oil_reference_cost" type="DECIMAL(12,2)" />
            <column name="default_gas_reference_cost" type="DECIMAL(12,2)" />
            <column name="km_per_kwh" type="DECIMAL(8,3)" />
            <column name="liters_per_100km" type="DECIMAL(8,3)" />
            <column name="invest_cost" type="DECIMAL(12,2)" />
            <column name="heating_monthly_distribution" type="VARCHAR(100)" defaultValue="22,18,12,5,3,1,1,1,2,3,13,19">
                <constraints nullable="false" />
            </column>
            <column name="overview_layout" type="VARCHAR(10)" defaultValue="KPI">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createIndex tableName="energy_profile" indexName="idx_energy_profile_user_id">
            <column name="user_id" />
        </createIndex>
    </changeSet>

</databaseChangeLog>
