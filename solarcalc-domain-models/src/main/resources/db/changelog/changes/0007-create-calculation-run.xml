<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        logicalFilePath="0007-create-calculation-run.xml"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0007-create-calculation-run" author="solarcalc">
        <createTable tableName="calculation_run">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_calculation_run_tenant"
                             references="tenant(id)" />
            </column>
            <column name="energy_profile_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_calculation_run_profile"
                             references="energy_profile(id)" />
            </column>
            <column name="monthly_input_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_calculation_run_input"
                             references="monthly_energy_input(id)" />
            </column>
            <column name="allocation_policy_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_calculation_run_policy"
                             references="allocation_policy(id)" />
            </column>
            <column name="period" type="VARCHAR(7)">
                <constraints nullable="false" />
            </column>
            <!-- Immutable: no updated_at -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createIndex tableName="calculation_run" indexName="idx_calculation_run_tenant_profile_period">
            <column name="tenant_id" />
            <column name="energy_profile_id" />
            <column name="period" />
        </createIndex>
    </changeSet>

</databaseChangeLog>
